# Локальная демонстрация; данные вымышленные.
HOST=127.0.0.1
PORT=3000
DATA_DIR=./data
SEED_DEMO=true

# Для новой рабочей установки: SEED_DEMO=false и собственные реквизиты.
# После создания администратора очистите ОБА bootstrap-поля.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Необязательно: отдельный PostgreSQL; по умолчанию дисковый PGlite.
DATABASE_URL=

# Только для рабочего HTTPS-развёртывания за доверенным прокси.
# NODE_ENV=production
# TRUST_PROXY=1

# Создание новых сценариев и озвучки на сервере. При просмотре готовых уроков ключ не нужен.
# Дополнительно университет должен явно разрешить settings.allowExternalAI=true.
# Вместо переменной ключа можно использовать DATA_DIR/secrets/google-ai.key (закрытый файл).
# GEMINI_API_KEY=
# GEMINI_API_KEY_FILE=
# GEMINI_SCRIPT_MODEL=gemini-3.8-flash
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# Production Compose can pin another TTS model with AI_TEACHER_TTS_MODEL in release.env.
# GEMINI_TTS_VOICE=Puck

# Озвучка через OpenRouter; сценарии по-прежнему могут использовать Google.
# TTS_BACKEND=google
# Для переключения: TTS_BACKEND=openrouter и отдельный ключ OpenRouter.
# OPENROUTER_API_KEY_FILE=/absolute/private/path/openrouter.key
# OPENROUTER_TTS_MODEL=google/gemini-3.8-flash-tts
# OPENROUTER_TTS_VOICE=Puck
# Production Compose: задайте в release.env TTS_BACKEND=openrouter и
# AI_TEACHER_OPENROUTER_KEY=/opt/ai-teacher/secrets/openrouter.key.
# Файл принадлежит UID 1000, режим 0400; ключ не включается в образ или репозиторий.
# Без AI_TEACHER_OPENROUTER_KEY монтируется пустой /dev/null; Google остаётся по умолчанию.
# Возврат к Google: TTS_BACKEND=google и пересоздание только контейнера ai-teacher.
# Google-ключ и AI_TEACHER_TTS_MODEL сохраняются независимо от провайдера озвучки.

# Состояние серверного backup-таймера для настроек администратора.
# Production Compose монтирует каталог operations только для чтения в /run/operations.
# OPERATIONS_STATUS_FILE=/run/operations/backup-status.json

# Изолированный серверный Codex worker. Эти параметры не передают ключ OpenAI в приложение.
# Для production сначала deploy/setup-authoring.sh, затем compose.authoring.yaml.
# CODEX_WORKER_URL=http://author-broker:8080
# CODEX_WORKER_TOKEN_FILE=/run/secrets/author-worker.token
# 2D uses its own broker, token and persistent queue. New lessons default to 2D.
# CODEX_2D_WORKER_URL=http://author-broker-2d:8080
# CODEX_2D_WORKER_TOKEN_FILE=/run/secrets/author-2d-worker.token
# Автор входит отдельно через codex login --device-auth в /opt/ai-teacher/codex-auth.
# Не копируйте авторизацию настольного Codex в проект, .env или образ Docker.
